# Base API URL for backend PHP endpoints
# In local development with Vite proxy, leave empty or set to "/api"
# If connecting directly to PHP server without proxy:
# VITE_API_BASE_URL=http://localhost:8000/api
# If connecting to XAMPP / Apache:
# VITE_API_BASE_URL=http://localhost/healthcare/backend/api
VITE_API_BASE_URL=/api
